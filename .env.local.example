# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend (email — v2, non attivo in v1)
RESEND_API_KEY=re_your_key
RESEND_FROM_EMAIL=noreply@yourdomain.com

# PDF Storage bucket name
SUPABASE_STORAGE_BUCKET_LEAFLETS=leaflets
SUPABASE_STORAGE_BUCKET_ASSETS=assets

# WhatsApp Business Cloud API (Meta) — multi-tenant via Embedded Signup
# Verify token globale per il webhook (uno per tutta l'app Meta)
WHATSAPP_VERIFY_TOKEN=sartoria_webhook_secret
# App Secret dalla pagina Settings > Basic della tua Meta App (per firma webhook)
META_APP_SECRET=your_app_secret
# App credentials per Embedded Signup (OAuth)
META_APP_ID=your_app_id
NEXT_PUBLIC_META_APP_ID=your_app_id
# Config ID Embedded Signup (Meta Developers > WhatsApp > Embedded Signup)
META_EMBEDDED_SIGNUP_CONFIG_ID=your_config_id
NEXT_PUBLIC_META_EMBEDDED_SIGNUP_CONFIG_ID=your_config_id
# Redirect URI registrato nell'app Meta (deve combaciare ESATTAMENTE)
META_OAUTH_REDIRECT_URI=https://fiilo.it/api/auth/whatsapp/callback
# Chiave random (>= 32 char) usata per cifrare i token nei DB.
# Va inoltre settata come Postgres custom config:
#   ALTER DATABASE postgres SET app.wa_encryption_key = '<key>';
#   SELECT pg_reload_conf();
WHATSAPP_TOKEN_ENCRYPTION_KEY=

# Legacy single-tenant (deprecato, non più letto dal webhook)
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_CLOUD_API_TOKEN=EAAxxxxx

# AI provider (free tier) — usato per categorize/transcribe/extract/summary
# Crea una API key gratuita su https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key
# Fallback opzionale (Google AI Studio https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Anthropic (Claude Haiku 4.5) — sintesi AI scheda cliente
# Crea API key su https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your_key
