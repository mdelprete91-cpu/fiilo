# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend (email — v2, non attivo in v1)
RESEND_API_KEY=re_your_key
RESEND_FROM_EMAIL=noreply@yourdomain.com

# PDF Storage bucket name
SUPABASE_STORAGE_BUCKET_LEAFLETS=leaflets
SUPABASE_STORAGE_BUCKET_ASSETS=assets

# WhatsApp Business Cloud API (Meta)
# Phone Number ID dal Meta Developer Dashboard (WhatsApp > Configuration)
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
# System User Access Token (permanente, generato in Meta Business Suite)
WHATSAPP_CLOUD_API_TOKEN=EAAxxxxx
# Token segreto scelto da te, da inserire nel campo "Verify token" in Meta
WHATSAPP_VERIFY_TOKEN=sartoria_webhook_secret
# App Secret dalla pagina Settings > Basic della tua Meta App
META_APP_SECRET=your_app_secret

# AI provider (free tier) — usato per categorize/transcribe/extract/summary
# Crea una API key gratuita su https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key
# Fallback opzionale (Google AI Studio https://aistudio.google.com/apikey)
GEMINI_API_KEY=
